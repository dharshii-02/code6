if __name__ == '__main__':
    students = []
    for _ in range(int(input())):
        name = input()
        score = float(input())
        students.append([name, score])

    # Get all unique scores and sort them to find the second lowest
    grades = sorted(set([s[1] for s in students]))
    second_lowest_grade = grades[1]

    # Filter names that match the second lowest grade
    result_names = [s[0] for s in students if s[1] == second_lowest_grade]

    # Sort names alphabetically and print
    for name in sorted(result_names):
        print(name)
